#!/bin/bash
# Ginsu — cut the work in half.
#
# Let your Claude Code agent spawn and drive a Codex agent running in a REAL
# terminal window you can watch. Claude sends prompts, Codex works in the repo,
# Claude reads the clean reply and sends the next one — a real conversation
# (Codex remembers across turns). You watch it all and keep talking to Claude.
#
#   ginsu spawn  <worker> <repo>              open a visible Codex worker in <repo>
#   ginsu send   <worker> "<prompt>" [flags]  send a prompt; WAITS and prints Codex's reply
#         flags: --no-wait  fire-and-forget    --effort low|medium|high|xhigh|max  (this turn)
#                --model <name>  (this turn)
#   ginsu review <worker> [focus]             adversarial code review of the repo (a mode)
#   ginsu test   <worker> [focus]             write + run tests for the current changes (a mode)
#   ginsu read   <worker>                      print the worker's latest reply
#   ginsu diff   <worker>                      show what Codex changed (git status + diff)
#   ginsu logs   <worker> [n]                  show Codex's stderr (debug a failed turn)
#   ginsu tail   <worker>                      turn count, queue depth, session id, last reply
#   ginsu list   |  ginsu status <worker>  |  ginsu stop <worker>
#
# `send` returns Codex's reply as text and EXITS NONZERO if the turn failed or
# timed out — so a caller can trust the reply or react to the failure. Prompts
# are queued per worker (no lost prompts), and each reply is tied to its own
# prompt. Backbone: the official Codex CLI (`codex exec --json` + `resume`).
set -uo pipefail

CODEX="${GINSU_CODEX:-$(command -v codex || echo "$HOME/.npm-global/bin/codex")}"
MODEL="${GINSU_MODEL:-gpt-5.6-sol}"
EFFORT="${GINSU_EFFORT:-high}"        # low|medium|high|xhigh|max (ultra = token footgun, never default)
SANDBOX="${GINSU_SANDBOX:-write}"     # write (workspace-write, default) | bypass (full access) | read (read-only)
TERM_PREF="${GINSU_TERM:-auto}"       # auto | iterm | terminal | tmux
ROOT="${GINSU_HOME:-$HOME/.ginsu}"
TIMEOUT="${GINSU_TIMEOUT:-900}"       # seconds a blocking `send` waits before giving up

case "$SANDBOX" in
  bypass) SBX=(--dangerously-bypass-approvals-and-sandbox);;
  write)  SBX=(--sandbox workspace-write);;
  read)   SBX=(--sandbox read-only);;
  *) echo "ginsu: bad GINSU_SANDBOX '$SANDBOX' (use bypass|write|read)" >&2; exit 1;;
esac

w_dir(){ echo "$ROOT/$1"; }
die(){ echo "ginsu: $*" >&2; exit 1; }
# worker names become path components AND get embedded in the AppleScript shell
# string the window runs — so allow ONLY [A-Za-z0-9_-]. This closes both path
# traversal and shell-injection-into-the-terminal (RCE) at once.
valid_worker(){ case "$1" in ''|*[!A-Za-z0-9_-]*) return 1;; *) return 0;; esac; }
# alive only if the pid is running AND is actually a ginsu loop (guards PID reuse)
worker_alive(){ local p; p="$(cat "$1/pid" 2>/dev/null)" || return 1; [ -n "$p" ] && kill -0 "$p" 2>/dev/null && ps -p "$p" -o command= 2>/dev/null | grep -q ginsu; }
# best-effort: close the Terminal/iTerm window whose tty matches (never launches an app)
close_window(){
  local t="$1"; { [ -n "$t" ] && [ "$(uname)" = Darwin ]; } || return 0
  if osascript -e 'application "Terminal" is running' 2>/dev/null | grep -q true; then
    osascript >/dev/null 2>&1 <<OSA || true
tell application "Terminal"
  repeat with w in windows
    try
      repeat with tb in tabs of w
        if tty of tb is "$t" then close w saving no
      end repeat
    end try
  end repeat
end tell
OSA
  fi
  if osascript -e 'application "iTerm" is running' 2>/dev/null | grep -q true; then
    osascript >/dev/null 2>&1 <<OSA || true
tell application "iTerm"
  repeat with w in windows
    repeat with tb in tabs of w
      repeat with s in sessions of tb
        try
          if tty of s is "$t" then close w
        end try
      end repeat
    end repeat
  end repeat
end tell
OSA
  fi
}

# allocate a monotonic ticket under a mkdir-lock (breaks a stale lock after ~2s)
alloc_seq(){ local d="$1" i=0 s; while ! mkdir "$d/lock" 2>/dev/null; do i=$((i+1)); [ "$i" -gt 100 ] && rmdir "$d/lock" 2>/dev/null; sleep 0.02; done; s=$(( $(cat "$d/seq" 2>/dev/null || echo 0) + 1 )); echo "$s" > "$d/seq"; rmdir "$d/lock" 2>/dev/null; echo "$s"; }
# keep only the newest ~30 completed-turn results
prune_done(){ local d="$1" keep=30 files n; files="$(ls "$d/done" 2>/dev/null | grep -vE '\.st$' | sort -n)"; n="$(printf '%s\n' "$files" | grep -c .)"; if [ "${n:-0}" -gt "$keep" ]; then printf '%s\n' "$files" | head -n "$((n-keep))" | while read -r old; do rm -f "$d/done/$old" "$d/done/$old.st"; done; fi; }

# The renderer: turns `codex exec --json` events into a clean, colored window.
write_renderer(){
  cat > "$1" <<'PYEOF'
import sys, json, time, select, os, shutil, textwrap, re

sidfile = sys.argv[1] if len(sys.argv) > 1 else ""
repo    = sys.argv[2] if len(sys.argv) > 2 else ""

NOCOLOR = bool(os.environ.get("NO_COLOR"))
def c(code): return "" if NOCOLOR else code
RESET=c("\033[0m"); DIM=c("\033[2m"); B=c("\033[1m")
BLUE=c("\033[38;5;39m"); CYAN=c("\033[38;5;44m"); GREEN=c("\033[38;5;42m")
GREY=c("\033[38;5;245m"); DK=c("\033[38;5;240m"); LT=c("\033[38;5;250m")
RED=c("\033[38;5;203m"); YEL=c("\033[38;5;179m")

SPIN="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
start=time.time(); si=0; usage=None

def width():
    try: return shutil.get_terminal_size((80,24)).columns
    except Exception: return 80

def clearline():
    sys.stdout.write("\r\033[K")

def out(s=""):
    clearline(); sys.stdout.write(s+"\n"); sys.stdout.flush()

def wrap(text, indent="   "):
    w=width(); lines=[]
    for para in text.split("\n"):
        if not para.strip(): lines.append(""); continue
        for seg in textwrap.wrap(para, max(24, w-len(indent))):
            lines.append(indent+seg)
    return "\n".join(lines)

def spin():
    global si
    el=int(time.time()-start)
    sys.stdout.write("\r%s%s%s %sCodex working…%s %s%ds%s" %
        (GREY, SPIN[si%len(SPIN)], RESET, DIM, RESET, DIM, el, RESET))
    sys.stdout.flush(); si+=1

def rel(p):
    if repo and p.startswith(repo): p=p[len(repo):].lstrip("/")
    return p

ANSI_RE=re.compile(r'\x1b\[[0-9;?]*[ -/]*[@-~]')
def clean(s): return ANSI_RE.sub('', s or '').replace('\r','')

def unwrap(cmd):
    cmd=clean(cmd)
    m=re.match(r"^(?:/[\w./-]+/)?(?:ba|z)?sh\s+-l?c\s+(['\"])(.*)\1\s*$", cmd.strip(), re.S)
    return m.group(2).strip() if m else cmd.strip()

def render(o):
    global usage
    t=o.get("type")
    if t=="thread.started":
        tid=o.get("thread_id")
        if tid and sidfile:
            cur=""
            try: cur=open(sidfile).read().strip()
            except Exception: pass
            if not cur: open(sidfile,"w").write(tid)
        return
    if t=="turn.completed":
        usage=o.get("usage"); return
    if t!="item.completed": return
    it=o.get("item",{}); k=it.get("type")

    if k=="agent_message":
        txt=(it.get("text") or "").rstrip()
        if not txt: return
        out(); out("%s%s❯ Codex%s" % (B,CYAN,RESET)); out("%s%s%s" % (LT,wrap(txt),RESET))
    elif k=="reasoning":
        txt=(it.get("text") or "").strip()
        if txt: out("%s· %s%s" % (DIM, txt.split("\n")[0][:200], RESET))
    elif k=="command_execution":
        out("%s$ %s%s" % (GREEN, unwrap(it.get("command","")), RESET))
        aout=clean(it.get("aggregated_output") or "").rstrip("\n")
        if aout:
            ls=aout.split("\n"); shown=ls[:18]
            for L in shown: out("%s  %s%s" % (DIM, L[:width()-2], RESET))
            if len(ls)>len(shown): out("%s  … (+%d lines)%s" % (DIM, len(ls)-len(shown), RESET))
        ec=it.get("exit_code")
        if ec not in (0,None): out("%s  exit %s%s" % (RED, ec, RESET))
    elif k=="file_change":
        for ch in it.get("changes",[]):
            kind=ch.get("kind","?"); p=rel(ch.get("path",""))
            sym={"add":"+","update":"~","delete":"-"}.get(kind,"±")
            col={"add":GREEN,"update":YEL,"delete":RED}.get(kind,GREY)
            out("%s%s %s%s %s(%s)%s" % (col,sym,p,RESET, DIM, kind, RESET))
    elif k=="error":
        msg=it.get("message","")
        if msg.startswith("Skill descriptions were shortened"): return   # harmless startup notice
        if msg.strip(): out("%s! %s%s" % (RED, msg.strip(), RESET))
    else:
        out("%s· %s%s" % (DIM, k, RESET))

def footer():
    clearline(); el=int(time.time()-start)
    if usage:
        def k(n): return "%.1fk"%(n/1000) if n>=1000 else str(n)
        out("%s◇ %ds · in %s (%s cached) · out %s%s" % (DK, el,
            k(usage.get("input_tokens",0)), k(usage.get("cached_input_tokens",0)),
            k(usage.get("output_tokens",0)), RESET))
    else:
        out("%s◇ %ds%s" % (DK, el, RESET))

while True:
    r,_,_=select.select([sys.stdin],[],[],0.12)
    if r:
        line=sys.stdin.readline()
        if not line: break
        line=line.strip()
        if not line: continue
        try: o=json.loads(line)
        except Exception: continue
        render(o)
    else:
        spin()
footer()
PYEOF
}

# open the worker loop in a visible terminal, portably
launch_window(){
  local worker="$1" repo="$2" pref="$TERM_PREF"
  local cmd="clear; exec '$SELF' _loop '$worker'"
  if [ "$pref" = auto ]; then
    if [ "$(uname)" = Darwin ]; then
      if [ "${TERM_PROGRAM:-}" = iTerm.app ] || osascript -e 'application "iTerm" is running' 2>/dev/null | grep -q true; then pref=iterm; else pref=terminal; fi
    else pref=tmux; fi
  fi
  case "$pref" in
    iterm)
      err="$(osascript 2>&1 >/dev/null <<OSA
tell application "iTerm"
  create window with default profile
  tell current session of current window to write text "$cmd"
end tell
OSA
)"; [ $? -eq 0 ] || die "couldn't open an iTerm window (osascript: ${err:-permission denied?}). Grant Automation permission (System Settings ▸ Privacy & Security ▸ Automation) or set GINSU_TERM=terminal|tmux"
      echo "opened in iTerm";;
    terminal)
      err="$(osascript 2>&1 >/dev/null <<OSA
tell application "Terminal"
  activate
  do script "$cmd"
end tell
OSA
)"; [ $? -eq 0 ] || die "couldn't open a Terminal window (osascript: ${err:-permission denied?}). Grant Automation permission (System Settings ▸ Privacy & Security ▸ Automation) or set GINSU_TERM=tmux"
      echo "opened in Terminal";;
    tmux)
      command -v tmux >/dev/null || die "tmux not found — install it, or set GINSU_TERM=iterm|terminal on macOS"
      tmux new-session -d -s "ginsu-$worker" "$SELF" _loop "$worker" || die "tmux couldn't start the worker session"
      echo "started in tmux — watch it with:  tmux attach -t ginsu-$worker";;
    *) die "bad GINSU_TERM '$pref'";;
  esac
}

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cmd="${1:-}"; shift || true

case "$cmd" in

spawn)
  worker="${1:?usage: ginsu spawn <worker> <repo>}"; repo="${2:?need repo path}"
  valid_worker "$worker" || die "bad worker name '$worker' — letters, digits, '_' and '-' only"
  repo="$(cd "$repo" 2>/dev/null && pwd)" || die "no such repo: $2"
  PY="$(command -v python3 || command -v python || true)"
  [ -n "$PY" ] || die "ginsu needs python3 (or python) on PATH for the worker window"
  d="$(w_dir "$worker")"
  if worker_alive "$d"; then
    echo "worker '$worker' already running (pid $(cat "$d/pid"))"; exit 0; fi
  # one worker per repo — refuse to open a second in the same tree (they'd clobber each other)
  for od in "$ROOT"/*/; do [ -d "$od" ] || continue; ow="$(basename "$od")"; [ "$ow" = "$worker" ] && continue
    if worker_alive "$od" && [ "$(cat "$od/repo" 2>/dev/null)" = "$repo" ]; then die "worker '$ow' is already running in $repo — one worker per repo (ginsu stop $ow first)"; fi; done
  [ -x "$CODEX" ] || command -v "$CODEX" >/dev/null || die "codex CLI not found ($CODEX) — install Codex first"
  mkdir -p "$d"; rm -rf "$d/queue" "$d/meta" "$d/done" "$d/lock"
  rm -f "$d/inbox" "$d/session.id" "$d/response.out" "$d/codex.err"
  mkdir -p "$d/queue" "$d/meta" "$d/done"; echo 0 > "$d/turn"; echo 0 > "$d/seq"; echo "$repo" > "$d/repo"
  write_renderer "$d/render.py"
  launch_window "$worker" "$repo"
  echo "spawned worker '$worker' → $repo   ($MODEL, effort $EFFORT, sandbox $SANDBOX)"
  echo "  ginsu send $worker \"do X\"   |   ginsu review $worker   |   ginsu diff $worker"
  ;;

_loop)  # internal: the worker loop, runs inside the visible terminal
  worker="${1:?}"; d="$(w_dir "$worker")"; repo="$(cat "$d/repo")"
  cd "$repo" || exit 1
  trap 'rm -f "$d/pid"' EXIT
  echo $$ > "$d/pid"
  tty > "$d/tty" 2>/dev/null || true
  mkdir -p "$d/queue" "$d/meta" "$d/done"
  [ -f "$d/render.py" ] || write_renderer "$d/render.py"
  PY="$(command -v python3 || command -v python || true)"
  [ -n "$PY" ] || { echo "ginsu: python3 required for the worker renderer"; sleep 5; exit 1; }
  printf '\033]0;ginsu: %s\007' "$worker"          # name the window so it's findable
  cols=$(tput cols 2>/dev/null || echo 80); rule=$(printf '─%.0s' $(seq 1 "$cols"))
  printf '\033[1;38;5;208m  ▟▛ ginsu\033[0m  \033[1mworker:\033[0m %s\n' "$worker"
  printf '  \033[2mrepo\033[0m   %s\n' "$repo"
  printf '  \033[2mmodel\033[0m  %s \033[2m·\033[0m effort %s \033[2m·\033[0m sandbox %s\n' "$MODEL" "$EFFORT" "$SANDBOX"
  printf '\033[38;5;240m%s\033[0m\n' "$rule"
  printf '\033[2m  waiting for prompts…\033[0m\n'
  while true; do
    t="$(ls "$d/queue" 2>/dev/null | sort -n | head -1)"
    if [ -z "$t" ]; then sleep 0.2; continue; fi
    prompt="$(cat "$d/queue/$t")"; rm -f "$d/queue/$t"
    eff="$EFFORT"; mdl="$MODEL"
    if [ -f "$d/meta/$t" ]; then read -r me mm < "$d/meta/$t" || true
      [ -n "${me:-}" ] && [ "$me" != - ] && eff="$me"
      [ -n "${mm:-}" ] && [ "$mm" != - ] && mdl="$mm"; rm -f "$d/meta/$t"; fi
    cols=$(tput cols 2>/dev/null || echo 80); rule=$(printf '─%.0s' $(seq 1 "$cols"))
    n="$(cat "$d/turn" 2>/dev/null || echo 0)"
    extra=""; [ "$eff" != "$EFFORT" ] && extra=" · effort $eff"; [ "$mdl" != "$MODEL" ] && extra="$extra · model $mdl"
    printf '\n\033[38;5;240m%s\033[0m\n' "$rule"
    printf '\033[1;38;5;39m▸ Claude\033[0m \033[2m· turn %s%s\033[0m\n' "$((n+1))" "$extra"
    printf '\033[38;5;250m%s\033[0m\n\n' "$prompt"
    : > "$d/response.out"
    base=("${SBX[@]}" -m "$mdl" -c "model_reasoning_effort=\"$eff\"" --json -o "$d/response.out")
    if [ -s "$d/session.id" ]; then
      "$CODEX" exec resume "${base[@]}" "$(cat "$d/session.id")" "$prompt" </dev/null 2>>"$d/codex.err" | "$PY" "$d/render.py" "$d/session.id" "$repo"
      rc=${PIPESTATUS[0]}
    else
      "$CODEX" exec "${base[@]}" -C "$repo" "$prompt" </dev/null 2>>"$d/codex.err" | "$PY" "$d/render.py" "$d/session.id" "$repo"
      rc=${PIPESTATUS[0]}
    fi
    if [ "$rc" = 0 ]; then
      if [ -s "$d/response.out" ]; then cp "$d/response.out" "$d/done/$t"
      else printf '(Codex finished with no message)' > "$d/done/$t"; cp "$d/done/$t" "$d/response.out"; fi
      echo 0 > "$d/done/$t.st"
    else
      { printf '⚠ ginsu: Codex turn failed (exit %s).\n' "$rc"; echo '--- last lines of codex.err ---'; tail -n 4 "$d/codex.err" 2>/dev/null; } > "$d/done/$t"
      cp "$d/done/$t" "$d/response.out"; echo "$rc" > "$d/done/$t.st"
      printf '\033[38;5;203m✗ Codex turn failed (exit %s) — see codex.err\033[0m\n' "$rc"
    fi
    echo $(( n + 1 )) > "$d/turn"
    prune_done "$d"
  done
  ;;

send)
  worker="${1:?usage: ginsu send <worker> \"<prompt>\" [--no-wait] [--effort E] [--model M]}"; shift
  { [ $# -ge 1 ] && [ -n "$1" ]; } || die "need a prompt — ginsu send <worker> \"…\""
  prompt="$1"; shift
  valid_worker "$worker" || die "bad worker name '$worker' — letters, digits, '_' and '-' only"
  d="$(w_dir "$worker")"; [ -d "$d" ] || die "no worker '$worker' — ginsu spawn it first"
  worker_alive "$d" || die "worker '$worker' isn't running (window closed?) — re-spawn it"
  wait=1; eff=-; mdl=-
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-wait) wait=0;;
      --effort) eff="${2:?--effort needs a value}"; shift;;
      --model)  mdl="${2:?--model needs a value}"; shift;;
      *) die "unknown flag '$1'";;
    esac; shift
  done
  mkdir -p "$d/queue" "$d/meta" "$d/done"
  t="$(alloc_seq "$d")"
  if [ "$eff" != - ] || [ "$mdl" != - ]; then printf '%s %s\n' "$eff" "$mdl" > "$d/meta/$t"; fi
  printf '%s' "$prompt" > "$d/queue/.$t.tmp"; mv "$d/queue/.$t.tmp" "$d/queue/$t"
  if [ "$wait" = 1 ]; then
    for _ in $(seq 1 $(( TIMEOUT * 4 )) ); do
      if [ -f "$d/done/$t.st" ]; then st="$(cat "$d/done/$t.st")"; cat "$d/done/$t"; rm -f "$d/done/$t" "$d/done/$t.st"; exit "${st:-1}"; fi
      if ! worker_alive "$d"; then die "worker '$worker' died mid-turn — check the window / ginsu logs $worker"; fi
      sleep 0.25
    done
    die "timed out after ${TIMEOUT}s waiting for '$worker' (ticket $t) — ginsu tail $worker; ginsu logs $worker may explain (raise GINSU_TIMEOUT for long tasks)"
  fi
  echo "queued → $worker (ticket $t)"
  ;;

review)
  worker="${1:?usage: ginsu review <worker> [focus]}"; focus="${2:-}"
  exec "$SELF" send "$worker" "You are an adversarial code reviewer. Review the current repository and its working changes and try to REFUTE their correctness — hunt for real bugs, edge cases, races, and security issues.${focus:+ Focus on: $focus.} Report each finding as: severity · file:line · the concrete failure (inputs → wrong result) · a one-line fix. If you find nothing real, say so plainly. Do not modify anything."
  ;;

test)
  worker="${1:?usage: ginsu test <worker> [focus]}"; focus="${2:-}"
  exec "$SELF" send "$worker" "Write and run tests for the current changes.${focus:+ Focus on: $focus.} Cover the happy path and the edge cases most likely to break it, actually run them, and report pass/fail with the command output. Only change code if a test reveals a clear bug — if so, say what you changed and why."
  ;;

read)  worker="${1:?}"; cat "$(w_dir "$worker")/response.out" 2>/dev/null || echo "(no reply yet)";;
logs)  worker="${1:?}"; tail -n "${2:-40}" "$(w_dir "$worker")/codex.err" 2>/dev/null || echo "(no Codex stderr yet)";;
diff)  worker="${1:?}"; r="$(cat "$(w_dir "$worker")/repo")"; git -C "$r" --no-pager status --short; echo; \
        if git -C "$r" rev-parse -q --verify HEAD >/dev/null 2>&1; then git -C "$r" --no-pager diff HEAD; else git -C "$r" --no-pager diff; fi;;
tail)  worker="${1:?}"; d="$(w_dir "$worker")"; qd="$(ls "$d/queue" 2>/dev/null | wc -l | tr -d ' ')"; \
        echo "turn=$(cat "$d/turn" 2>/dev/null) queued=$qd session=$(cat "$d/session.id" 2>/dev/null)"; echo '--- last reply ---'; cat "$d/response.out" 2>/dev/null;;
status) worker="${1:?}"; d="$(w_dir "$worker")"; \
        if worker_alive "$d"; then echo "$worker: RUNNING (pid $(cat "$d/pid")) repo=$(cat "$d/repo") turn=$(cat "$d/turn")"; else echo "$worker: stopped"; fi;;
list)  for d in "$ROOT"/*/; do [ -d "$d" ] || continue; w="$(basename "$d")"; \
        worker_alive "$d" && echo "● $w  RUNNING  $(cat "$d/repo")" || echo "○ $w  stopped"; done;;
stop)  worker="${1:?}"; d="$(w_dir "$worker")"; tt="$(cat "$d/tty" 2>/dev/null)"; \
        kill "$(cat "$d/pid" 2>/dev/null)" 2>/dev/null && echo "stopped $worker" || echo "$worker not running"; \
        tmux kill-session -t "ginsu-$worker" 2>/dev/null || true; close_window "$tt";;
version|-v|--version) echo "ginsu 1.3.1";;
*) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//';;
esac
